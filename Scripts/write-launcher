#!/bin/sh
# Write the launcher that `just install` puts on PATH.
#
#   write-launcher <real-executable> <launcher-path>
#
# Run through with-linux-deps, so whatever the build depended on is in this
# script's own environment and can be baked into the launcher.
#
# Why a launcher rather than the executable itself: eacp reaches Vulkan through
# volk, which dlopens libvulkan.so.1 when the first GPUView is created. Nothing
# links against it, so no RUNPATH entry points at it. When the dev shell built
# the app, the binary runs against that shell's glibc, whose loader never
# searches /usr/lib -- so the distro's libvulkan.so.1 is invisible to it, the
# dlopen fails, and every view silently falls back to rendering off-screen: the
# window opens and stays empty. `just run` avoids that by running the app inside
# the shell; a desktop entry or a bare `cowterm` has no such shell around it,
# which is what this launcher replaces.
#
# When the dependencies came from the system instead, there is nothing to carry
# and the launcher is a plain exec.
set -e

real=$1
launcher=$2

if [ -z "$real" ] || [ -z "$launcher" ]; then
    echo "usage: write-launcher <real-executable> <launcher-path>" >&2
    exit 2
fi

# Only store paths are worth baking. Anything else is either already the
# system's default search path or specific to the shell that ran the install.
store_only() {
    printf '%s' "$1" | tr ':' '\n' | grep '^/nix/store/' || true
}

libs=$(store_only "$LD_LIBRARY_PATH" | tr '\n' ':' | sed 's/:$//')
icds=$(store_only "$VK_DRIVER_FILES" | tr '\n' ':' | sed 's/:$//')

{
    echo '#!/bin/sh'
    echo '# Generated by Scripts/write-launcher -- re-run `just install` to refresh.'
    echo 'set -e'
    echo

    if [ -n "$libs" ] || [ -n "$icds" ]; then
        cat <<'PREAMBLE'
# Baked at install time from the dev shell that built this app: the Vulkan
# loader it has to dlopen, and the drivers that loader should use. Both are
# store paths, so a `nix-collect-garbage` that removes them leaves this
# launcher pointing at nothing -- hence the check rather than a silent
# fallback to an empty window.
PREAMBLE
        [ -n "$libs" ] && printf 'COWTERM_VK_LIBS=%s\n' "'$libs'"
        [ -n "$icds" ] && printf 'COWTERM_VK_ICDS=%s\n' "'$icds'"
        echo
        cat <<'CHECK'
missing=
for entry in $(printf '%s' "${COWTERM_VK_LIBS:-}${COWTERM_VK_ICDS:+:$COWTERM_VK_ICDS}" | tr ':' ' '); do
    [ -e "$entry" ] || missing="$missing $entry"
done

if [ -n "$missing" ]; then
    echo "cowterm: the Vulkan files this launcher was built against are gone:" >&2
    for entry in $missing; do echo "  $entry" >&2; done
    echo "Re-run \`just install\` in the CowTerm checkout to rebuild it." >&2
    exit 1
fi

# A full if rather than `[ ... ] && export`, which under `set -e` would end
# the script rather than skip the export when the list is empty.
if [ -n "${COWTERM_VK_LIBS:-}" ]; then
    export LD_LIBRARY_PATH="${LD_LIBRARY_PATH:+$LD_LIBRARY_PATH:}$COWTERM_VK_LIBS"
fi

# Left alone if the caller set one, so a machine with real hardware drivers
# keeps its own choice.
if [ -n "${COWTERM_VK_ICDS:-}" ] && [ -z "${VK_DRIVER_FILES:-}" ] \
   && [ -z "${VK_ICD_FILENAMES:-}" ]; then
    export VK_DRIVER_FILES="$COWTERM_VK_ICDS"
fi

CHECK
    fi

    # Absolute, and exec rather than a subshell: eacp decides
    # standalone-vs-plugin by comparing /proc/self/exe against the path dladdr
    # reports for the module, and it finds CowTermDaemon next to
    # /proc/self/exe. exec keeps both pointing at the real executable.
    printf 'exec %s "$@"\n' "'$real'"
} > "$launcher"

chmod +x "$launcher"
