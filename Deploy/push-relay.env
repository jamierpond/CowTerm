# `op run --env-file` fills these from 1Password at the relay's start. The
# service account on the relay host can read only the CowTerm Push vault.
# Nothing secret lives in the repo.
COWTERM_PUSH_KEY_ID=op://CowTerm Push/APNs Key/key id
COWTERM_PUSH_TEAM_ID=op://CowTerm Push/APNs Key/team id
COWTERM_PUSH_PRIVATE_KEY=op://CowTerm Push/APNs Key/private key
