# App Store Connect: `op run --env-file Deploy/asc.env -- <command>` fills these
# from the "Cows In Love" vault of the personal 1Password account, the same
# item Cows releases with (scripts/asc-run.sh does that). Nothing secret lives
# in the repo.
COWTERM_IOS_TEAM=op://Cows In Love/App Store Connect API/team id
COWTERM_ASC_KEY_ID=op://Cows In Love/App Store Connect API/key id
COWTERM_ASC_ISSUER_ID=op://Cows In Love/App Store Connect API/issuer id
COWTERM_ASC_KEY_P8=op://Cows In Love/App Store Connect API/private key
